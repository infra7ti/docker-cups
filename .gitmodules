[submodule "cups-doc_root"]
	path = resources/doc-root
	url = https://github.com/ekaaty/cups-tailwind.git
	ref = main
	folder = doc-root
	ignore = all
[submodule "cups-templates"]
	path = resources/templates
	url = https://github.com/ekaaty/cups-tailwind.git
	ref = main
	folder = templates
	ignore = all
