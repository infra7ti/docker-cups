#!/usr/bin/env bash
# @file full/build.env
# @brief Build configuration and environment variables for CUPS full variant
#
# SPDX-FileCopyrightText: 2024-2026 Infra7 Serviços em TI
# SPDX-License-Identifier: GPL-2.0-or-later

DEBIAN_FRONTEND=noninteractive

BUILD_PACKAGES=" \
    apt-utils \
    build-essential \
    dc \
    libcups2-dev \
    libjbig-dev \
    git \
"

PACKAGES=" \
    ${BUILD_PACKAGES} \
    avahi-daemon \
    bluez-cups \
    ca-certificates \
    cups \
    cups-browsed \
    cups-filters \
    dbus-daemon \
    foomatic-db-compressed-ppds \
    hp-ppd \
    hpijs-ppds \
    hplip \
    liblcms2-utils \
    openprinting-ppds \
    printer-driver-all \
    usbutils \
    wget \
"
PURGE_PACKAGES="${BUILD_PACKAGES} printer-driver-foo2zjs"

FOO2ZJS="20260206"

__configure_cups() {
    local config="/etc/cups/cupsd.conf"

    sed -i 's/Listen localhost:631/Listen [::]:631\nListen 0.0.0.0:631/' ${config} && \
    sed -i 's/Browsing Off/Browsing On/' ${config} && \
    sed -i 's/<Location \/>/<Location \/>\n  Allow All/' ${config} && \
    sed -i 's/<Location \/admin>/<Location \/admin>\n  Allow All\n  Require user @SYSTEM/' ${config} && \
    sed -i 's/<Location \/admin\/conf>/<Location \/admin\/conf>\n  Allow All/' ${config} && \
    echo "ServerAlias *" >> ${config} && \
    echo "DefaultEncryption Never" >> ${config}
}

__backup_cups() {
    cp -rp /etc/cups /etc/cups~
}

__compile_foo2zjs() {
    git -c advice.detachedHead=false clone \
        --depth 1 \
        --branch ${FOO2ZJS} \
        https://github.com/OpenPrinting/foo2zjs.git /tmp/foo2zjs \
    && cd /tmp/foo2zjs \
    && make \
    && make install \
    && ln -s psicc /usr/bin/foo2zjs-icc2ps \
    && cd / \
    && rm -rf /tmp/foo2zjs
}

__override_templates() {
    local _cups_version=$(dpkg -l cups | sed '/cups/!d;s/.*cups\s*\(.*\)-.*deb.*/\1/')

    cp -a /usr/share/cups/doc-root/{help,images} /files/doc-root/
    rm -rf /usr/share/cups/{doc-root,templates}
    sed -Ei "s/\{cups_version\}/${_cups_version}/g" \
        /files/doc-root/index.html \
        /files/templates/header.tmpl
    cp -rp /files/{doc-root,templates} /usr/share/cups/
    rm -rf /files
}

# vim: ts=4:sw=4:sts=4:et
