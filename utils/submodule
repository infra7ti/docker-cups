import sys
from pathlib import Path

# Insert local context to path to guarantee clean resolution of sibling imports
sys.path.append(str(Path(__file__).parent / "lib"))

try:
    import submodule
except ImportError as e:
    print(f"  Error: Failed to initialize execution wrapper context: {e}", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    submodule.main()
